{
    "_id": "_design/webseq",
    "language": "javascript",
    "autoupdate": false,
    "views": {
        "listing_by_name": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'webseq' || doc.pvt_deleted) return;",
                "  emit(doc.name, null);",
                "}"
            ]
        }
    }
}
