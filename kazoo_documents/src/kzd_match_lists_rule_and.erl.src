-module(kzd_match_lists_rule_and).

-export([new/0]).
-export([rules/1, rules/2, set_rules/2]).


-include("kz_documents.hrl").

-type doc() :: kz_json:object().
-export_type([doc/0]).

-define(SCHEMA, <<"match_lists.rule.and">>).

-spec new() -> doc().
new() ->
    kz_json_schema:default_object(?SCHEMA).

-spec rules(doc()) -> kz_term:api_objects().
rules(Doc) ->
    rules(Doc, 'undefined').

-spec rules(doc(), Default) -> kz_json:objects() | Default.
rules(Doc, Default) ->
    kz_json:get_list_value([<<"rules">>], Doc, Default).

-spec set_rules(doc(), kz_json:objects()) -> doc().
set_rules(Doc, Rules) ->
    kz_json:set_value([<<"rules">>], Rules, Doc).
