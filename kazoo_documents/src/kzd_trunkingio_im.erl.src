-module(kzd_trunkingio_im).

-export([new/0]).
-export([delivery_receipt/1, delivery_receipt/2, set_delivery_receipt/2]).
-export([from/1, from/2, set_from/2]).
-export([media_urls/1, media_urls/2, set_media_urls/2]).
-export([other_recipients/1, other_recipients/2, set_other_recipients/2]).
-export([received_at/1, received_at/2, set_received_at/2]).
-export([reference_id/1, reference_id/2, set_reference_id/2]).
-export([text/1, text/2, set_text/2]).
-export([to/1, to/2, set_to/2]).


-include("kz_documents.hrl").

-type doc() :: kz_json:object().
-export_type([doc/0]).

-define(SCHEMA, <<"trunkingio_im">>).

-spec new() -> doc().
new() ->
    kz_json_schema:default_object(?SCHEMA).

-spec delivery_receipt(doc()) -> kz_term:api_boolean().
delivery_receipt(Doc) ->
    delivery_receipt(Doc, 'undefined').

-spec delivery_receipt(doc(), Default) -> boolean() | Default.
delivery_receipt(Doc, Default) ->
    kz_json:get_boolean_value([<<"delivery_receipt">>], Doc, Default).

-spec set_delivery_receipt(doc(), boolean()) -> doc().
set_delivery_receipt(Doc, DeliveryReceipt) ->
    kz_json:set_value([<<"delivery_receipt">>], DeliveryReceipt, Doc).

-spec from(doc()) -> kz_term:api_binary().
from(Doc) ->
    from(Doc, 'undefined').

-spec from(doc(), Default) -> binary() | Default.
from(Doc, Default) ->
    kz_json:get_binary_value([<<"from">>], Doc, Default).

-spec set_from(doc(), binary()) -> doc().
set_from(Doc, From) ->
    kz_json:set_value([<<"from">>], From, Doc).

-spec media_urls(doc()) -> any().
media_urls(Doc) ->
    media_urls(Doc, 'undefined').

-spec media_urls(doc(), Default) -> any() | Default.
media_urls(Doc, Default) ->
    kz_json:get_value([<<"media_urls">>], Doc, Default).

-spec set_media_urls(doc(), any()) -> doc().
set_media_urls(Doc, MediaUrls) ->
    kz_json:set_value([<<"media_urls">>], MediaUrls, Doc).

-spec other_recipients(doc()) -> any().
other_recipients(Doc) ->
    other_recipients(Doc, 'undefined').

-spec other_recipients(doc(), Default) -> any() | Default.
other_recipients(Doc, Default) ->
    kz_json:get_value([<<"other_recipients">>], Doc, Default).

-spec set_other_recipients(doc(), any()) -> doc().
set_other_recipients(Doc, OtherRecipients) ->
    kz_json:set_value([<<"other_recipients">>], OtherRecipients, Doc).

-spec received_at(doc()) -> kz_term:api_binary().
received_at(Doc) ->
    received_at(Doc, 'undefined').

-spec received_at(doc(), Default) -> binary() | Default.
received_at(Doc, Default) ->
    kz_json:get_binary_value([<<"received_at">>], Doc, Default).

-spec set_received_at(doc(), binary()) -> doc().
set_received_at(Doc, ReceivedAt) ->
    kz_json:set_value([<<"received_at">>], ReceivedAt, Doc).

-spec reference_id(doc()) -> kz_term:api_binary().
reference_id(Doc) ->
    reference_id(Doc, 'undefined').

-spec reference_id(doc(), Default) -> binary() | Default.
reference_id(Doc, Default) ->
    kz_json:get_binary_value([<<"reference_id">>], Doc, Default).

-spec set_reference_id(doc(), binary()) -> doc().
set_reference_id(Doc, ReferenceId) ->
    kz_json:set_value([<<"reference_id">>], ReferenceId, Doc).

-spec text(doc()) -> any().
text(Doc) ->
    text(Doc, 'undefined').

-spec text(doc(), Default) -> any() | Default.
text(Doc, Default) ->
    kz_json:get_value([<<"text">>], Doc, Default).

-spec set_text(doc(), any()) -> doc().
set_text(Doc, Text) ->
    kz_json:set_value([<<"text">>], Text, Doc).

-spec to(doc()) -> kz_term:api_binary().
to(Doc) ->
    to(Doc, 'undefined').

-spec to(doc(), Default) -> binary() | Default.
to(Doc, Default) ->
    kz_json:get_binary_value([<<"to">>], Doc, Default).

-spec set_to(doc(), binary()) -> doc().
set_to(Doc, To) ->
    kz_json:set_value([<<"to">>], To, Doc).
