-module(kzd_storage_attachment_google_drive).

-export([new/0]).
-export([handler/1, handler/2, set_handler/2]).
-export([settings/1, settings/2, set_settings/2]).
-export([settings_folder_id/1, settings_folder_id/2, set_settings_folder_id/2]).
-export([settings_oauth_doc_id/1, settings_oauth_doc_id/2, set_settings_oauth_doc_id/2]).


-include("kz_documents.hrl").

-type doc() :: kz_json:object().
-export_type([doc/0]).

-define(SCHEMA, <<"storage.attachment.google_drive">>).

-spec new() -> doc().
new() ->
    kz_json_schema:default_object(?SCHEMA).

-spec handler(doc()) -> kz_term:api_binary().
handler(Doc) ->
    handler(Doc, 'undefined').

-spec handler(doc(), Default) -> binary() | Default.
handler(Doc, Default) ->
    kz_json:get_binary_value([<<"handler">>], Doc, Default).

-spec set_handler(doc(), binary()) -> doc().
set_handler(Doc, Handler) ->
    kz_json:set_value([<<"handler">>], Handler, Doc).

-spec settings(doc()) -> kz_term:api_object().
settings(Doc) ->
    settings(Doc, 'undefined').

-spec settings(doc(), Default) -> kz_json:object() | Default.
settings(Doc, Default) ->
    kz_json:get_json_value([<<"settings">>], Doc, Default).

-spec set_settings(doc(), kz_json:object()) -> doc().
set_settings(Doc, Settings) ->
    kz_json:set_value([<<"settings">>], Settings, Doc).

-spec settings_folder_id(doc()) -> kz_term:api_binary().
settings_folder_id(Doc) ->
    settings_folder_id(Doc, 'undefined').

-spec settings_folder_id(doc(), Default) -> binary() | Default.
settings_folder_id(Doc, Default) ->
    kz_json:get_binary_value([<<"settings">>, <<"folder_id">>], Doc, Default).

-spec set_settings_folder_id(doc(), binary()) -> doc().
set_settings_folder_id(Doc, SettingsFolderId) ->
    kz_json:set_value([<<"settings">>, <<"folder_id">>], SettingsFolderId, Doc).

-spec settings_oauth_doc_id(doc()) -> kz_term:api_ne_binary().
settings_oauth_doc_id(Doc) ->
    settings_oauth_doc_id(Doc, 'undefined').

-spec settings_oauth_doc_id(doc(), Default) -> kz_term:ne_binary() | Default.
settings_oauth_doc_id(Doc, Default) ->
    kz_json:get_ne_binary_value([<<"settings">>, <<"oauth_doc_id">>], Doc, Default).

-spec set_settings_oauth_doc_id(doc(), kz_term:ne_binary()) -> doc().
set_settings_oauth_doc_id(Doc, SettingsOauthDocId) ->
    kz_json:set_value([<<"settings">>, <<"oauth_doc_id">>], SettingsOauthDocId, Doc).
