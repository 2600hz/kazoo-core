%%%-----------------------------------------------------------------------------
-module(kzd_external_numbers).

-export([new/0]).
-export([name/1, name/2, set_name/2]).
-export([number/1, number/2, set_number/2]).


-include("kz_documents.hrl").

-type doc() :: kz_json:object().
-export_type([doc/0]).

-define(SCHEMA, <<"external_numbers">>).

-spec new() -> doc().
new() ->
    kz_json_schema:default_object(?SCHEMA).

-spec name(doc()) -> kz_term:api_ne_binary().
name(Doc) ->
    name(Doc, 'undefined').

-spec name(doc(), Default) -> kz_term:ne_binary() | Default.
name(Doc, Default) ->
    kz_json:get_ne_binary_value([<<"name">>], Doc, Default).

-spec set_name(doc(), kz_term:ne_binary()) -> doc().
set_name(Doc, Name) ->
    kz_json:set_value([<<"name">>], Name, Doc).

-spec number(doc()) -> kz_term:api_ne_binary().
number(Doc) ->
    number(Doc, 'undefined').

-spec number(doc(), Default) -> kz_term:ne_binary() | Default.
number(Doc, Default) ->
    kz_json:get_ne_binary_value([<<"number">>], Doc, Default).

-spec set_number(doc(), kz_term:ne_binary()) -> doc().
set_number(Doc, Number) ->
    kz_json:set_value([<<"number">>], Number, Doc).
