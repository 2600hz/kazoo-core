{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.im.inbound",
    "description": "AMQP API for im.inbound",
    "properties": {
        "Account-ID": {
            "type": "string"
        },
        "Body": {
            "type": "string"
        },
        "Charges": {
            "type": "number"
        },
        "Custom-SIP-Headers": {
            "type": "object"
        },
        "Custom-Vars": {
            "type": "object"
        },
        "Event-Category": {
            "enum": [
                "mms",
                "sms"
            ]
        },
        "Event-Name": {
            "enum": [
                "inbound"
            ]
        },
        "From": {
            "type": "string"
        },
        "Message-ID": {
            "type": "string"
        },
        "Rate": {
            "type": "number"
        },
        "Request": {
            "type": "string"
        },
        "Route-ID": {
            "type": "string"
        },
        "Route-Type": {
            "enum": [
                "offnet",
                "onnet"
            ],
            "type": "string"
        },
        "System-ID": {
            "type": "string"
        },
        "To": {
            "items": {
                "type": "string"
            },
            "type": [
                "string",
                "array"
            ]
        },
        "To-Numbers": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "Transaction-ID": {
            "type": "string"
        }
    },
    "required": [
        "Body",
        "From",
        "Message-ID",
        "To"
    ],
    "type": "object"
}
