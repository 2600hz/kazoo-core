{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.conference.discovery_req",
    "description": "AMQP API for conference.discovery_req",
    "properties": {
        "Call": {
            "type": "object"
        },
        "Conference-Doc": {
            "type": "string"
        },
        "Conference-ID": {
            "minLength": 1,
            "type": "string"
        },
        "Conference-Name": {
            "minLength": 1,
            "type": "string"
        },
        "End-On-Last-Member-Leave": {
            "type": "string"
        },
        "End-On-Leave": {
            "type": "string"
        },
        "Event-Category": {
            "enum": [
                "conference"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "discovery_req"
            ],
            "type": "string"
        },
        "Max-Participants": {
            "minimum": 1,
            "type": "string"
        },
        "Member-Join-Deaf": {
            "type": "string"
        },
        "Member-Join-Muted": {
            "type": "string"
        },
        "Moderator": {
            "type": "string"
        },
        "Moderator-Join-Deaf": {
            "type": "string"
        },
        "Moderator-Join-Muted": {
            "type": "string"
        },
        "Participant-Join-Video-Muted": {
            "type": "string"
        },
        "Play-Entry-Tone": {
            "type": "string"
        },
        "Play-Exit-Tone": {
            "type": "string"
        },
        "Play-Welcome": {
            "type": "string"
        },
        "Play-Welcome-Media": {
            "minLength": 1,
            "type": "string"
        },
        "Wait-For-Moderator": {
            "type": "string"
        }
    },
    "required": [
        "Call",
        "Event-Category",
        "Event-Name"
    ],
    "type": "object"
}
