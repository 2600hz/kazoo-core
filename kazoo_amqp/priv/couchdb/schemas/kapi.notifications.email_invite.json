{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.notifications.email_invite",
    "description": "AMQP API for notifications.email_invite",
    "properties": {
        "Account-DB": {
            "type": "string"
        },
        "Attachment-URL": {
            "type": "string"
        },
        "Bcc": {
            "type": "string"
        },
        "Cc": {
            "type": "string"
        },
        "Conference-Call-In-Numbers": {
            "minItems": 1,
            "type": "string"
        },
        "Conference-ID": {
            "type": "string"
        },
        "Conference-Link": {
            "type": "string"
        },
        "Conference-Name": {
            "type": "string"
        },
        "Conference-Numbers": {
            "items": {
                "type": "string"
            },
            "type": "string"
        },
        "Conference-Participant-Pins": {
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "type": "array"
        },
        "Event-Category": {
            "enum": [
                "notification"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "email_invite"
            ],
            "type": "string"
        },
        "From": {
            "type": "string"
        },
        "Guests": {
            "minItems": 1,
            "type": "string"
        },
        "HTML": {
            "type": "string"
        },
        "Invite-Message": {
            "type": "string"
        },
        "Preview": {
            "type": "boolean"
        },
        "Reply-To": {
            "type": "string"
        },
        "Subject": {
            "type": "string"
        },
        "Text": {
            "type": "string"
        },
        "To": {
            "type": "string"
        }
    },
    "required": [
        "Conference-Call-In-Numbers",
        "Conference-ID",
        "Conference-Name",
        "Conference-Participant-Pins",
        "Guests",
        "Invite-Message"
    ],
    "type": "object"
}
