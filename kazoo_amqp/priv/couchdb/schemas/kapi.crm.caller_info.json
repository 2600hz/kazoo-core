        "Account-ID": {
            "minLength": 1,
            "type": "string"
        },
        "CRM-Platform": {
            "minLength": 1,
            "type": "string"
        },
        "Caller-ID": {
            "minLength": 1,
            "type": "string"
        },
        "Event-Category": {
            "enum": [
                "crm"
            ]
        },
        "Event-Name": {
            "enum": [
                "caller_info"
            ]
        }
    },
    "required": [
        "Caller-ID",
        "CRM-Platform"
    ],
    "type": "object"
}
