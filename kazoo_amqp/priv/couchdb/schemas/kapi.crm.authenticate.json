{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.crm.authenticate",
    "description": "AMQP API for crm.authenticate",
    "properties": {
        "Client-ID": {
            "minLength": 1,
            "type": "string"
        },
        "Client-Secret": {
            "minLength": 1,
            "type": "string"
        },
        "Event-Category": {
            "enum": [
                "crm-salesforce"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "authenticate"
            ]
        },
        "Instance-Url": {
            "minLength": 1,
            "type": "string"
        }
    },
    "required": [
        "Client-ID",
        "Client-Secret",
        "Instance-Url"
    ],
    "type": "object"
}
