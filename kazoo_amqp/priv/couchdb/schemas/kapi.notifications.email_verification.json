{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.notifications.email_verification",
    "description": "AMQP API for notifications.email_verification",
    "properties": {
        "Account-DB": {
            "type": "string"
        },
        "Account-ID": {
            "minLength": 1,
            "type": "string"
        },
        "Attachment-URL": {
            "type": "string"
        },
        "Bcc": {
            "type": "string"
        },
        "Cc": {
            "type": "string"
        },
        "Email": {
            "minLength": 1,
            "type": "string"
        },
        "Event-Category": {
            "enum": [
                "notification"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "email_verification"
            ],
            "type": "string"
        },
        "From": {
            "type": "string"
        },
        "HTML": {
            "type": "string"
        },
        "Preview": {
            "type": "boolean"
        },
        "Reply-To": {
            "type": "string"
        },
        "Subject": {
            "type": "string"
        },
        "Text": {
            "type": "string"
        },
        "To": {
            "type": "string"
        },
        "Verification-Code": {
            "minLength": 1,
            "type": "string"
        }
    },
    "required": [
        "Account-ID",
        "Email",
        "Event-Category",
        "Event-Name",
        "Verification-Code"
    ],
    "type": "object"
}
