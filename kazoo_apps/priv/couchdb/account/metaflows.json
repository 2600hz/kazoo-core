{
    "_id": "_design/metaflows",
    "autoupdate": false,
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (!doc.metaflows || doc.pvt_deleted) return;",
                "  emit(doc._id, doc.metaflows);",
                "}"
            ]
        }
    }
}
