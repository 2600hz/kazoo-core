{
    "_id": "_design/apps_store",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "autoupdate": false,
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'app' || doc.pvt_deleted) return;",
                "  emit(doc.name, {",
                "    id: doc._id,",
                "    name: doc.name,",
                "    phase: doc.phase,",
                "    'i18n': doc['i18n'],",
                "    tags: doc.tags,",
                "    api_url: doc.api_url,",
                "    source_url: doc.source_url,",
                "    published: doc.published",
                "  });",
                "}"
            ]
        },
        "find_by_hash": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'app' || doc.pvt_deleted || !doc.pvt_app_hash) return;",
                "  emit(doc.pvt_app_hash, null);",
                "}"
            ]
        }
    }
}
