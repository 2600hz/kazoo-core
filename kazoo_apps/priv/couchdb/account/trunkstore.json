{
    "_id": "_design/trunkstore",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'sys_info' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'name': doc.name,",
                "    'servers': doc.servers",
                "  });",
                "}"
            ],
            "reduce": "_count"
        },
        "lookup_did": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'trunk_server' || doc.pvt_deleted) return;",
                "  if (!doc.enabled) return;",
                "  if (!doc.server.options.enabled) return;",
                "  var DIDs = Iterator(doc.server.DIDs);",
                "  for (var DID in DIDs) {",
                "    emit(DID[0], null);",
                "  });",
                "}"
            ]
        }
    }
}
