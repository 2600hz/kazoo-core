{
    "_id": "_design/scope_restrictions",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope_restriction' || doc.pvt_deleted) return;",
                "  doc.scopes.forEach(function(scope) {",
                "    if (!Array.isArray(scope)) {",
                "      emit(scope.split(':'), null)",
                "    } else {",
                "      emit(scope, null)",
                "    }",
                "  });",
                "}"
            ]
        }
    }
}
