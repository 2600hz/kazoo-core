{
    "_id": "_design/scope_restrictions",
    "autoupdate": false,
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope_restriction' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    _id: doc._id,",
                "    scopes: doc.scopes,",
                "    token_restrictions: doc.token_restrictions",
                "  });",
                "}"
            ]
        }
    }
}
