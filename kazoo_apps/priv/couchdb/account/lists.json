{
    "_id": "_design/lists",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "autoupdate": false,
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'list' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'id': doc._id,",
                "    'name': doc.name,",
                "    'description': doc.description,",
                "    'list_type': doc.list_type",
                "  });",
                "}"
            ]
        },
        "entries": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_deleted) return;",
                "  if (doc.pvt_type === 'list_entry') {",
                "    for (var key in doc.contacts) {",
                "      if (doc.contacts[key].default && doc.contacts[key].type == 'phone_number')",
                "        var number = doc.contacts[key].contact ? doc.contacts[key].contact : doc.number;",
                "    }",
                "    emit(doc.list_id, {",
                "      capture_group_key: doc.capture_group_key,",
                "      capture_group_length: doc.capture_group_length,",
                "      name: doc.name,",
                "      number: number,",
                "      pattern: doc.pattern,",
                "      prefix: doc.prefix,",
                "      regexp: doc.regexp,",
                "      type: doc.type",
                "    })",
                "  } else if (doc.pvt_type === 'list' && doc.entries) {",
                "    for (var key in doc.entries) {",
                "      if (!doc.entries.hasOwnProperty(key)) continue;",
                "      for (var key2 in doc.entries[key]) {",
                "        if (doc.entries[key].contacts[key2].default && doc.entries[key].contacts[key2].type == 'phone_number')",
                "          var number = doc.entries[key].contacts[key2].contact ? doc.entries[key].contacts[key2].contact : doc.entries[key].number;",
                "      }",
                "      emit(doc._id, {",
                "        capture_group_key: key,",
                "        capture_group_length: doc.length,",
                "        name: doc.entries[key].cid_name || doc.entries[key].name,",
                "        number: doc.entries[key].cid_number || doc.entries[key].number || number,",
                "        pattern: doc.entries[key].pattern,",
                "        prefix: doc.entries[key].prefix,",
                "        regexp: doc.entries[key].regexp,",
                "        type: doc.entries[key].type",
                "      })",
                "    }",
                "  } else {",
                "    return",
                "  }",
                "}"
            ]
        },
        "match_prefix": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'list_entry' || doc.pvt_deleted || !(doc.number || doc.prefix || doc.contacts)) return;",
                "  for (var key in doc.contacts) {",
                "    if (doc.contacts[key].default && doc.contacts[key].type == 'phone_number') {",
                "      var number = doc.contacts[key].contact ? doc.contacts[key].contact : doc.number;",
                "      emit(number ? number : doc.prefix, null);",
                "    } else {",
                "      return;",
                "    }",
                "  }",
                "}"
            ]
        },
        "match_prefix_in_list": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'list_entry' || doc.pvt_deleted || !(doc.number || doc.prefix || doc.contacts)) return;",
                "  for (var key in doc.contacts) {",
                "    if (doc.contacts[key].default && doc.contacts[key].type == 'phone_number') {",
                "      var number = doc.contacts[key].contact ? doc.contacts[key].contact : doc.number;",
                "      emit([doc.list_id, number ? number : doc.prefix], null);",
                "    } else {",
                "      return;",
                "    }",
                "  }",
                "}"
            ]
        },
        "regexps_in_list": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'list_entry' || doc.pvt_deleted || !(doc.regexp || doc.pattern)) return;",
                "  emit(doc.list_id, doc.regexp ? doc.regexp : doc.pattern);",
                "}"
            ]
        }
    }
}
