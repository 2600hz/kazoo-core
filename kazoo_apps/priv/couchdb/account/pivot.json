{
    "_id": "_design/pivot",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'pivot' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'name': doc.name,",
                "    'number': doc.number,",
                "    'method': doc.method,",
                "    'req_timeout': doc.req_timeout,",
                "    'req_format': doc.req_format,",
                "    'voice_url': doc.voice_url,",
                "    'debug': doc.debug,",
                "    'req_body_format': doc.req_body_format",
                "  });",
                "}"
            ]
        }
    }
}
