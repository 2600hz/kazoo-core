{
    "_id": "_design/pivot",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'pivot' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'name': doc.name,",
                "    'url': doc.voice_url,",
                "    'method': doc.method",
                "  });",
                "}"
            ]
        }
    }
}
