{
    "_id": "_design/vmboxes",
    "kazoo": {
        "view_map": [
            {
                "classification": "account"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'vmbox' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    id: doc._id,",
                "    name: doc.name,",
                "    mailbox: doc.mailbox,",
                "    owner_id: doc.owner_id,",
                "    flags: doc.flags || []",
                "  });",
                "}"
            ]
        },
        "listing_by_mailbox": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'vmbox' || doc.pvt_deleted) return;",
                "  var aliases = doc.aliases || [];",
                "  var checklist = aliases.concat([doc.mailbox]);",
                "  for (var i in checklist) emit(checklist[i], {",
                "    'name': doc.name || doc._id",
                "  });",
                "}"
            ]
        }
    }
}
