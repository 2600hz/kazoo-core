{
    "_id": "_design/scopes",
    "kazoo": {
        "view_map": [
            {
                "database": "system_auth"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope' || doc.pvt_deleted) return;",
                "  emit(doc._id, {",
                "    'scopes': doc.scopes,",
                "    'allow_api_request': doc.allow_api_request || true",
                "  });",
                "}"
            ]
        },
        "list_allowed_by_scope_id": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope' || doc.pvt_deleted) return;",
                "  emit([doc.allow_api_request || true, doc._id], doc.scopes});",
                "}"
            ]
        }
    }
}
