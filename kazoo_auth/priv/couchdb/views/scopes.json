{
    "_id": "_design/scopes",
    "kazoo": {
        "view_map": [
            {
                "database": "system_auth"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope' || doc.pvt_deleted) return;",
                "  emit(doc.id || doc._id, doc.scopes);",
                "}"
            ]
        },
        "list_by_id_permission": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope' || doc.pvt_deleted) return;",
                "  if ((doc.permissions || []).length > 0) {",
                "    for (var i in doc.permissions) {",
                "      emit([doc.id || doc._id, doc.permissions[i].split(':')], doc.scopes || []);",
                "    }",
                "  }",
                "}"
            ]
        },
        "list_by_scope_id": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type !== 'scope' || doc.pvt_deleted) return;",
                "  emit([doc._id], null);",
                "  if (doc.scopes.length > 0) {",
                "    for (var i in doc.scopes) {",
                "      emit([doc.id || doc._id, doc.scopes[i]], {",
                "        _id: doc.scopes[i]",
                "      });",
                "    }",
                "  }",
                "}"
            ]
        }
    }
}
