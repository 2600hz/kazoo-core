{
    "_id": "_design/pivot",
    "kazoo": {
        "view_map": [
            {
                "classification": "modb"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "crossbar_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'pivot' || doc.pvt_deleted) return;",
                "  emit(doc._id, null);",
                "}"
            ]
        },
        "debug_listing": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'pivot_debug' || doc.pvt_deleted) return;",
                "  emit([doc.call_id, doc.pvt_created], {",
                "    'iteration': doc.iteration || 1,",
                "    'cf_flow_id': doc.cf_flow_id,",
                "    'cf_flow_name': doc.cf_flow_name,",
                "    'debug_type': doc.debug_type,",
                "    'has_error': Boolean(doc.has_error),",
                "    'error_type': doc.error_type || null",
                "  });",
                "}"
            ]
        },
        "first_iteration": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'pivot_debug' || doc.pvt_deleted || doc.iteration != 1) return;",
                "  emit(doc.pivot_session, {",
                "    'node': doc.pvt_node,",
                "    'cf_flow_id': doc.cf_flow_id,",
                "    'cf_flow_name': doc.cf_flow_name,",
                "    'call_id': doc.call_id,",
                "    'iteration': doc.iteration,",
                "    'session_at': doc.pivot_session,",
                "    'created': doc.pvt_created,",
                "    'uri': doc.uri,",
                "    'req_method': doc.method,",
                "    'req_headers': doc.req_headers || [],",
                "    'req_body': doc.req_body || \"\",",
                "    'status_code': doc.resp_status_code,",
                "    'resp_headers': doc.resp_headers,",
                "    'resp_body': doc.resp_body,",
                "    'resp_progress': doc.resp_progress,",
                "    'has_error': Boolean(doc.has_error),",
                "    'error_type': doc.error_type || null",
                "  });",
                "}"
            ],
            "reduce": [
                "function(keys, values, rereduce) {",
                "  return values.reduce(function(acc, val) {",
                "    acc.created = acc.created && val.created ? Math.min(acc.created, val.created) : (acc.created || val.created);",
                "    acc.call_id = acc.call_id || val.call_id;",
                "    acc.iteration = val.iteration || acc.iteration;",
                "    acc.node = acc.node || val.node;",
                "    acc.uri = acc.uri || val.uri;",
                "    acc.req_method = acc.req_method || val.req_method;",
                "    acc.req_headers = acc.req_headers || val.req_headers;",
                "    acc.req_body = acc.req_body || val.req_body;",
                "    acc.status_code = acc.status_code || val.status_code;",
                "    acc.resp_headers = acc.resp_headers || val.resp_headers;",
                "    acc.resp_body = acc.resp_body || val.resp_body;",
                "    acc.resp_progress = acc.resp_progress || val.resp_progress;",
                "    acc.has_error = acc.has_error || val.has_error;",
                "    acc.error_type = acc.error_type || val.error_type;",
                "    return acc;",
                "  });",
                "}"
            ]
        }
    }
}
