{
    "_id": "_design/storage_retries",
    "kazoo": {
        "view_map": [
            {
                "database": "storage_retry"
            }
        ]
    },
    "language": "javascript",
    "views": {
        "retries": {
            "map": [
                "function(doc) {",
                "  if (doc.pvt_type != 'storage_retry' || doc.pvt_deleted) return;",
                "  emit([doc.pvt_node, doc.remote_tag, doc._id], null);",
                "}"
            ]
        }
    }
}
